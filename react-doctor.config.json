{
  "serverAuthFunctionNames": [
    "requireSession",
    "requireUserId",
    "requireWaitlistManageAccess"
  ],
  "ignore": {
    "files": [
      ".agents/skills/**",
      ".claude/skills/**",
      ".next/**",
      "app/.well-known/**",
      "apps/*/app/.well-known/**",
      "apps/*/.next/**",
      "components/ai-elements/**",
      "components/ui/**",
      "packages/ai/components/ai-elements/**",
      "packages/ui/components/ui/**",
      "test/workflow-server-app/.next/**",
      "test/workflow-server-app/app/.well-known/**"
    ],
    "overrides": [
      {
        "files": [
          "app/**/opengraph-image.tsx",
          "app/**/twitter-image.tsx",
          "apps/*/app/**/opengraph-image.tsx",
          "apps/*/app/**/twitter-image.tsx"
        ],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": ["apps/*/mdx-components.tsx", "mdx-components.tsx"],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": [
          "apps/video/remotion/**",
          "components/social/**",
          "packages/ui/components/social/**",
          "remotion/**"
        ],
        "rules": [
          "react-doctor/design-no-em-dash-in-jsx-text",
          "react-doctor/design-no-redundant-padding-axes",
          "react-doctor/design-no-redundant-size-axes",
          "react-doctor/design-no-three-period-ellipsis",
          "react-doctor/no-inline-exhaustive-style",
          "react-doctor/no-long-transition-duration",
          "react-doctor/no-multi-comp",
          "react-doctor/no-pure-black-background",
          "react-doctor/no-render-in-render",
          "react-doctor/no-wide-letter-spacing",
          "react-doctor/rendering-svg-precision"
        ]
      },
      {
        "files": ["package.json"],
        "rules": ["deslop/unused-dependency", "deslop/unused-dev-dependency"]
      },
      {
        "files": [
          "application-invite-email.tsx",
          "auth-sign-in-otp-email.tsx",
          "packages/email/application-invite-email.tsx",
          "packages/email/auth-sign-in-otp-email.tsx",
          "packages/email/waitlist-admin-signup-email.tsx",
          "packages/email/waitlist-confirmation-email.tsx",
          "packages/email/waitlist-invite-email.tsx",
          "waitlist-admin-signup-email.tsx",
          "waitlist-confirmation-email.tsx",
          "waitlist-invite-email.tsx"
        ],
        "rules": ["deslop/unused-export"]
      },
      {
        "files": [
          "hooks/use-mobile.ts",
          "hooks/use-toast.ts",
          "packages/ui/hooks/use-mobile.ts",
          "packages/ui/hooks/use-toast.ts"
        ],
        "rules": ["deslop/unused-file"]
      },
      {
        "files": [
          "components/seo/json-ld.tsx",
          "packages/ui/components/seo/json-ld.tsx"
        ],
        "rules": ["react-doctor/no-danger"]
      },
      {
        "files": [
          "agents/components/agent-edit-sections.tsx",
          "agents/components/agent-form/runtime-settings.tsx",
          "marketing/components/landing/landing-links.tsx",
          "marketing/components/legal/legal-prose.tsx",
          "packages/shared/agents/components/agent-edit-sections.tsx",
          "packages/shared/agents/components/agent-form/runtime-settings.tsx",
          "packages/shared/marketing/components/landing/landing-links.tsx",
          "packages/shared/marketing/components/legal/legal-prose.tsx"
        ],
        "rules": ["react-doctor/no-multi-comp"]
      },
      {
        "files": [
          "agents/components/agent-form.tsx",
          "packages/shared/agents/components/agent-form.tsx",
          "packages/auth/components/login-form.tsx",
          "packages/shared/waitlist/components/waitlist-signup-form.tsx",
          "components/login-form.tsx",
          "waitlist/components/waitlist-signup-form.tsx"
        ],
        "rules": ["react-doctor/prefer-useReducer"]
      },
      {
        "files": [
          "marketing/components/landing/landing-composable-workbench.tsx",
          "packages/shared/marketing/components/landing/landing-composable-workbench.tsx"
        ],
        "rules": ["react-doctor/no-initialize-state"]
      },
      {
        "files": [
          "tools/components/tool-catalog/action-buttons.tsx",
          "tools/components/tool-catalog/attachment-form.tsx",
          "packages/ai/tools/components/tool-catalog/action-buttons.tsx",
          "packages/ai/tools/components/tool-catalog/attachment-form.tsx"
        ],
        "rules": ["react-doctor/no-many-boolean-props"]
      },
      {
        "files": [
          "app/agents/[agentId]/layout.tsx",
          "apps/app/app/agents/[agentId]/layout.tsx"
        ],
        "rules": ["react-doctor/jsx-no-jsx-as-prop"]
      },
      {
        "files": [
          "app/blog/[slug]/page.tsx",
          "apps/web/app/blog/[slug]/page.tsx"
        ],
        "rules": ["react-doctor/no-dynamic-import-path"]
      },
      {
        "files": ["app/waitlist/page.tsx", "apps/admin/app/waitlist/page.tsx"],
        "rules": ["react-doctor/async-parallel"]
      },
      {
        "files": [
          "agents/components/agent-events-workspace.tsx",
          "packages/shared/agents/components/agent-events-workspace.tsx"
        ],
        "rules": ["react-doctor/react-compiler-destructure-method"]
      }
    ]
  }
}
