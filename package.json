  "scripts": {
    "dev": "next dev",
    "dev:fresh": "pnpm run reset:workflow && next dev",
    "email": "email dev --dir emails --port 3000",
    "build": "next build",
    "build:vercel": "pnpm db:migrate && pnpm build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "vercel:sandboxes:audit": "tsx scripts/audit-vercel-sandboxes.ts",
    "vercel:sandboxes:destroy-all": "tsx scripts/destroy-vercel-sandboxes.ts",
    "reset:workflow": "rm -rf .swc .next app/.well-known",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run --config vitest.config.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.vitest.json",
    "test:workflow": "pnpm test:workflow:unit && pnpm test:workflow:integration && pnpm test:workflow:server",
    "test:workflow:integration": "cd test/workflow-fixtures && ../../node_modules/.bin/vitest run --config ../../vitest.workflow.config.ts",
    "test:workflow:server": "cd test/workflow-server-app && ../../node_modules/.bin/vitest run --config ../../vitest.workflow-server.config.ts",
    "test:workflow:unit": "vitest run --config vitest.workflow-unit.config.ts"
  }
}
