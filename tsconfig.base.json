{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@outname/ai": ["./packages/ai/index.ts"],
      "@outname/ai/*": ["./packages/ai/*"],
      "@outname/auth": ["./packages/auth/index.ts"],
      "@outname/auth/*": ["./packages/auth/*"],
      "@outname/db": ["./packages/db/index.ts"],
      "@outname/db/*": ["./packages/db/*"],
      "@outname/email": ["./packages/email/index.ts"],
      "@outname/email/*": ["./packages/email/*"],
      "@outname/shared": ["./packages/shared/index.ts"],
      "@outname/shared/*": ["./packages/shared/*"],
      "@outname/ui": ["./packages/ui/index.ts"],
      "@outname/ui/*": ["./packages/ui/*"],
      "@outname/workflow": ["./packages/workflow/index.ts"],
      "@outname/workflow/*": ["./packages/workflow/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["node", "react", "react-dom", "next", "mdx"]
  }
}
