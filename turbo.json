{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env.local", ".env.example"],
  "globalEnv": [
    "AI_GATEWAY_API_KEY",
    "APP_REVALIDATION_SECRET",
    "AUTH_COOKIE_DOMAIN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_URL",
    "CONNECTION_ENCRYPTION_KEY",
    "DATABASE_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_WEB_URL",
    "NODE_ENV",
    "RESEND_API_KEY",
    "VERCEL_API_PROJECT_ID",
    "VERCEL_APP_PROJECT_ID",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "VERCEL_ENV",
    "VERCEL_RELATED_PROJECTS",
    "VERCEL_WEB_PROJECT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "out/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "react-doctor": {
      "outputs": []
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["*.tsbuildinfo", ".tsbuildinfo/**"]
    }
  }
}
