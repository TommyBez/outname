{
  "name": "@outname/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @outname/db db:migrate && next build",
    "dev": "next dev -p 3001",
    "dev:fresh": "pnpm reset:workflow && pnpm dev",
    "lint": "ultracite check .",
    "react-doctor": "npx react-doctor@latest --verbose .",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "reset:workflow": "rm -rf .swc .next app/.well-known"
  },
  "dependencies": {
    "@ai-sdk/workflow": "1.0.2",
    "@outname/ai": "workspace:*",
    "@outname/auth": "workspace:*",
    "@outname/db": "workspace:*",
    "@outname/email": "workspace:*",
    "@outname/shared": "workspace:*",
    "@outname/ui": "workspace:*",
    "@outname/workflow": "workspace:*",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  }
}
